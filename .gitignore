# TypeScript incremental build cache
tsconfig.tsbuildinfo

# Backup / log artifacts (do not commit)
#
# `backups/` is where GitHub Actions writes daily D1 snapshots (and deletes
# them after 30 days); `archive/` holds retired snapshots and audit reports.
# Both directories hold machine-written JSON/SQL, so ignore those extensions
# everywhere while still tracking the human-authored markdown.
/archive/**/*.json
/archive/**/*.sql
backups/**/*.json
backups/**/*.sql
backups/old-images-backup/
!/backups/README.md
*.log
sync-env.log
prod-deploy-final.log
vercel-fix-deploy.log
verify-live.log
.env-test

# Photo scraper working tree (regenerated by scripts/download-*.js)
public/images/scraped/

# Supabase CLI temp
supabase/.temp/

# Image optimization outputs (re-generable via scripts/optimize-images.mjs)
public/images/**/*.webp
public/images/**/*.avif

# Playwright E2E artifacts
tests/**/playwright-report/
tests/**/test-results/
test-results/
playwright-report/
playwright/.cache/

.dev.vars
.dev.vars.*

# Machine-local Impeccable skill link (absolute path; not portable across laptops)
.claude/skills/impeccable
