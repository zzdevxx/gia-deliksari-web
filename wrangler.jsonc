{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gia-deliksari-web",
  "workers_dev": true,
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gia-deliksari-db",
      "database_id": "0f8a9e42-0a14-4a45-9cbb-55f7d8b2f5f1"
    }
  ],
  // Gallery master storage.
  //
  // OPERATOR ACTION REQUIRED — this binding is committed but INERT until R2 is
  // enabled on the account (Cloudflare requires a one-time ToS acceptance in the
  // dashboard before the R2 API will answer; `wrangler r2 bucket list` currently
  // returns error 10042 "Please enable R2 through the Cloudflare Dashboard").
  //
  // Until then `ctx.env.GALLERY_BUCKET` is undefined and both the upload and
  // sync routes fall through to Google Drive thumbnail URLs. Nothing breaks —
  // the gallery is just not mirrored to R2.
  //
  // To activate, once R2 is enabled:
  //   1. npx wrangler r2 bucket create gia-deliksari-gallery
  //   2. uncomment the r2_buckets block below
  //   3. npm run deploy
  //   4. point gallery.giadeliksari.org at the bucket (R2 custom domain) —
  //      that hostname does not resolve today, so R2_PUBLIC_URL must stay
  //      correct or the gallery will serve broken image URLs.
  //
  // "r2_buckets": [
  //   {
  //     "binding": "GALLERY_BUCKET",
  //     "bucket_name": "gia-deliksari-gallery"
  //   }
  // ],
  "routes": [
    { "pattern": "giadeliksari.my.id", "custom_domain": true },
    { "pattern": "www.giadeliksari.my.id", "custom_domain": true }
  ],
  // Runtime observability. Enabled 15 Okt 2026 after the audit found this portal
  // had none: a backup job wrote 17 empty snapshots over weeks and nothing
  // surfaced it. `persist` keeps invocation logs queryable in the dashboard
  // instead of only streaming them live, and sampling is 1.0 because this is a
  // low-traffic congregational site — the volume is affordable and a sampled-out
  // error is exactly the one you needed.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://giadeliksari.my.id",
    "R2_PUBLIC_URL": "https://gallery.giadeliksari.org",
    "YOUTUBE_CHANNEL_ID": "UCDh3ojx9ne3HOPoBuuoKlrg",
    "GOOGLE_DRIVE_PUBLIC_FOLDER_ID": "1T_ahqCtmOjdFl0L-MNu7bIQo-8Oz8y9h"
  }
}
