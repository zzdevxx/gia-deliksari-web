{
  "name": "gia-deliksari-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:cf": "opennextjs-cloudflare build",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "preview": "wrangler dev",
    "d1:create": "wrangler d1 create gia-deliksari-db",
    "d1:migrate:local": "wrangler d1 execute gia-deliksari-db --local --file=./migrations/0001_initial_schema.sql",
    "d1:migrate:remote": "wrangler d1 execute gia-deliksari-db --remote --file=./migrations/0001_initial_schema.sql",
    "d1:seed:local": "wrangler d1 execute gia-deliksari-db --local --file=./migrations/0002_initial_seed.sql",
    "d1:seed:remote": "wrangler d1 execute gia-deliksari-db --remote --file=./migrations/0002_initial_seed.sql",
    "d1:backup:local": "wrangler d1 export gia-deliksari-db --local --output=./backups/d1-local.sql",
    "d1:backup:remote": "wrangler d1 export gia-deliksari-db --remote --output=./backups/d1-remote.sql",
    "lint": "next lint",
    "optimize:images": "node scripts/optimize-images.mjs",
    "mirror:b2": "node scripts/mirror-drive-to-b2.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "googleapis": "^176.0.0",
    "lucide-react": "^1.16.0",
    "next": "^16.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.1121.0"
  }
}
